# Guest mode works without Supabase. Set these on the Next.js server to enable accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The trusted URL used for email links and the social sign-in callback.
DEAR_TOMORROW_APP_URL=http://127.0.0.1:3002
# Server only. Required for the private file proxy and verified account deletion.
SUPABASE_SECRET_KEY=
# Enable only after the corresponding provider is configured in Supabase. Verify Apple before making it visible to users.
DEAR_TOMORROW_GOOGLE_SIGN_IN=false
DEAR_TOMORROW_APPLE_SIGN_IN=false
